# ============================================================================
#  Control plane — environment contract (see docs/OPS-001-environment-variables.md)
#  Same variables whether the control plane runs on Fly.io, Render, a VPS,
#  or (legacy option B) Vercel/Next.js. Loaded by dotenvy in dev; real env in prod.
#  Never commit real values.
# ============================================================================

# ── Core (required) ─────────────────────────────────────────────────────────
# Neon POOLED endpoint (must contain "-pooler"), role: control_plane
DATABASE_URL="postgresql://control_plane:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon DIRECT endpoint — migrations only, never at runtime
DATABASE_URL_UNPOOLED="postgresql://control_plane:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Read-only role used by every analytics query
DASHBOARD_DATABASE_URL="postgresql://dashboard_reader:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

SESSION_SECRET=""            # openssl rand -base64 32
APP_URL="http://localhost:8080"

# ── Pairing & device tokens (required) ──────────────────────────────────────
PAIRING_CODE_PEPPER=""       # openssl rand -base64 32
DEVICE_TOKEN_PEPPER=""       # openssl rand -base64 32

# ── Licensing (required) ────────────────────────────────────────────────────
LICENCE_PRIVATE_KEY=""       # base64 Ed25519 PKCS#8 — SERVER ONLY, mark Sensitive
LICENCE_PUBLIC_KEY=""        # base64 Ed25519 public — also baked into the exe
LICENCE_KEY_ID="k1"
LEASE_DAYS=14
GRACE_DAYS=14
SUSPEND_AFTER_DAYS=60

# ── Sync ingestion (optional) ───────────────────────────────────────────────
INGEST_MAX_BYTES=262144
INGEST_MAX_DAYS_PER_BATCH=31
SYNC_MIN_APP_VERSION="0.1.0"

# ── AI assistant (optional — omit ALL of these to disable) ──────────────────
GROQ_API_KEY=""              # gsk_...  server-side only
GROQ_MODEL="llama-3.1-8b-instant"
GROQ_TIMEOUT_MS=4000
AI_RATE_LIMIT_PER_HOUR=60
AI_MONTHLY_BUDGET_CENTS=500
FEATURE_AI=true

# ── Off-site backup (optional, encrypted client-side) ───────────────────────
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_RETENTION_DAYS=90
FEATURE_BACKUP_UPLOAD=false

# ── Notifications (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
RESEND_API_KEY=""
MAIL_FROM=""
CRON_SECRET=""               # openssl rand -base64 32 — required if crons are enabled

# ── Ops (required) ──────────────────────────────────────────────────────────
ADMIN_API_SECRET=""          # openssl rand -base64 32 — guards /api/admin/*
LOG_LEVEL="info"
FEATURE_CLOUD_DASHBOARD=true

# Optional observability / rate limiting
# SENTRY_DSN=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
